/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cobbled-maven-worker",
	"main": "src/index.tsx",
	"assets": {
		"directory": "./public"
	},
	"compatibility_date": "2026-06-05",
	"observability": {
		"enabled": true
	},
	"cache": {
		"enabled": true
	},
	"vars": {
		"SERVER_NAME": "Cobbled Creators :: Maven",
		"REPOSITORIES": "releases,snapshots",
		"CHECKSUM_VALIDATION": "true",
		"CHECKSUM_AUTOGENERATION": "true",
		"ALLOW_OVERWRITES": "false",
		"VALIDATE_PATHS": "true"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "METADATA_DEBOUNCER",
				"class_name": "MetadataDebouncer"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["MetadataDebouncer"]
		}
	],
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat", "enable_nodejs_console_module"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "maven-db",
			"database_id": "179a718f-99b9-4848-8eb9-d3852118a938"
		}
	],
	"r2_buckets": [
		{
			"binding": "releases",
			"bucket_name": "maven-releases",
			"remote": true
		},
		{
			"binding": "snapshots",
			"bucket_name": "maven-snapshots",
			"remote": true
		}
	],
	"routes": [
		{
			"pattern": "maven.cobbled-creators.org",
			"zone_name": "cobbled-creators.org",
			"custom_domain": true
		}
	]
}
